@model StudentFormViewModel
@{
    ViewData["Title"] = "Student Details";
    ViewData["Subtitle"] = Model.Name;
    var attendance = ViewBag.Attendance as IEnumerable<AttendanceRecordViewModel> ?? Enumerable.Empty<AttendanceRecordViewModel>();
}

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="mc-card text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Model.ProfilePhotoPath" alt="@Model.Name" class="rounded-circle border mb-3" width="120" height="120" style="object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:120px;height:120px;font-size:3rem;">
                    <i class="bi bi-person"></i>
                </div>
            }
            <h4 class="mb-1">@Model.Name</h4>
            <p class="text-muted mb-2">@Model.StudentId · @Model.EnrollmentNumber</p>
            @if (Model.IsActive)
            { <span class="badge text-bg-success">Active</span> }
            else
            { <span class="badge text-bg-secondary">Inactive</span> }
            @if (Model.FaceRegistered)
            {
                <div class="badge text-bg-success mt-2"><i class="bi bi-shield-check me-1"></i> Face Registered</div>
            }
            else
            {
                <div class="badge text-bg-warning mt-2"><i class="bi bi-exclamation-circle me-1"></i> Face Not Registered</div>
            }
            <div class="d-grid gap-2 mt-3">
                <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i> Edit</a>
                <a asp-action="ResetStudentPassword" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm"><i class="bi bi-key me-1"></i> Reset Password</a>
                <form asp-action="DeleteStudent" method="post"
                      onsubmit="return confirm('Delete @Model.Name (@Model.StudentId)? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="classId" value="@Model.ClassId" />
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-trash me-1"></i> Delete Student
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="mc-card">
            <h5 class="mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Profile Information</h5>
            <div class="row g-3">
                <div class="col-md-6"><span class="text-muted small">Email</span><div>@Model.Email</div></div>
                <div class="col-md-6"><span class="text-muted small">Mobile</span><div>@Model.Mobile</div></div>
                <div class="col-md-6"><span class="text-muted small">Department</span><div>@Model.Department</div></div>
                <div class="col-md-6"><span class="text-muted small">Course</span><div>@Model.Course</div></div>
                <div class="col-md-6"><span class="text-muted small">Semester</span><div>@Model.Semester</div></div>
                <div class="col-md-6"><span class="text-muted small">Date of Birth</span><div>@Model.DateOfBirth.ToString("dd MMM yyyy")</div></div>
                <div class="col-md-6"><span class="text-muted small">Gender</span><div>@Model.Gender</div></div>
                <div class="col-md-6"><span class="text-muted small">Guardian</span><div>@(Model.GuardianName ?? "—")</div></div>
                <div class="col-md-6"><span class="text-muted small">Guardian Phone</span><div>@(Model.GuardianPhone ?? "—")</div></div>
                <div class="col-md-6"><span class="text-muted small">Guardian Email</span><div>@(Model.GuardianEmail ?? "—")</div></div>
            </div>
        </div>
    </div>
</div>

<div class="mc-card">
    <h5 class="mb-3"><i class="bi bi-calendar-check me-2 text-primary"></i>Attendance History</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>In</th>
                    <th>Out</th>
                    <th>Source</th>
                    <th>Department</th>
                </tr>
            </thead>
            <tbody>
                @if (attendance.Any())
                {
                    foreach (var r in attendance.OrderByDescending(x => x.Date))
                    {
                        var badgeClass = AttendanceDisplay.BadgeClass(r.Status);
                        <tr>
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="badge @badgeClass">@AttendanceDisplay.StatusLabel(r.Status)</span></td>
                            <td class="text-success">@(r.FirstIn ?? "—")</td>
                            <td class="text-danger">@(r.LastOut ?? "—")</td>
                            <td>@r.Source</td>
                            <td>@r.Department</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No attendance records yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Students" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Students</a>
</div>
