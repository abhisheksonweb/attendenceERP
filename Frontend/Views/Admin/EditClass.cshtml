@model ClassFormViewModel
@{
    ViewData["Title"] = "Edit Class";
}


<div class="mc-card" style="max-width:720px;">
    <form asp-action="EditClass" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="Department" class="form-label"></label>
                <select asp-for="Department" class="form-select" id="departmentSelect"
                        data-selected="@Model.Department" required>
                    <option value="">-- Select department --</option>
                </select>
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Course" class="form-label"></label>
                <select asp-for="Course" class="form-select" id="courseSelect"
                        data-selected="@Model.Course" required disabled>
                    <option value="">-- Select course --</option>
                </select>
                <span asp-validation-for="Course" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Semester" class="form-label"></label>
                <select asp-for="Semester" class="form-select" id="semesterSelect"
                        data-selected="@Model.Semester" required disabled>
                    <option value="">-- Select semester --</option>
                </select>
                <span asp-validation-for="Semester" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MaxClassDurationMinutes" class="form-label"></label>
                <input asp-for="MaxClassDurationMinutes" class="form-control" type="number" min="1" max="1440" placeholder="60" />
                <div class="form-text">Total class length in minutes</div>
            </div>
            <div class="col-md-6">
                <label asp-for="MinAttendanceMinutes" class="form-label"></label>
                <input asp-for="MinAttendanceMinutes" class="form-control" type="number" min="1" max="1440" placeholder="45" />
                <div class="form-text">Present needs this much <strong>total stay</strong> (sum of IN→OUT visits). If blank, uses 50% of max duration.</div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-12 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="ClassDetail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
