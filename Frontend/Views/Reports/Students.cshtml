@model PagedResult<StudentFormViewModel>
@{
    ViewData["Title"] = "Student Report";
    ViewData["Subtitle"] = "Enrollment and profile overview";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <span class="text-muted">@Model.TotalCount students</span>
    <div class="btn-group">
        <a asp-action="ExportStudents" asp-route-format="pdf" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</a>
        <a asp-action="ExportStudents" asp-route-format="excel" class="btn btn-outline-primary btn-sm"><i class="bi bi-file-earmark-excel me-1"></i> Excel</a>
    </div>
</div>

<div class="mc-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Course</th>
                    <th>Semester</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var s in Model.Items)
                    {
                        <tr>
                            <td>@s.StudentId</td>
                            <td><strong>@s.Name</strong><br /><small class="text-muted">@s.Email</small></td>
                            <td>@s.Department</td>
                            <td>@s.Course</td>
                            <td>@s.Semester</td>
                            <td>@(s.IsActive ? Html.Raw("<span class='badge text-bg-success'>Active</span>") : Html.Raw("<span class='badge text-bg-secondary'>Inactive</span>"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No students found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> All Reports</a>
</div>
