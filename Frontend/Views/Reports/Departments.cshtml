@model IReadOnlyList<ChartPoint>
@{
    ViewData["Title"] = "Department Report";
    ViewData["Subtitle"] = "Students by department";
    var labels = Model.Select(x => x.Label).ToArray();
    var values = Model.Select(x => x.Value).ToArray();
}

<div class="d-flex justify-content-end mb-3">
    <div class="btn-group">
        <button type="button" class="btn btn-outline-primary btn-sm" disabled><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</button>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="alert('Export prototype only.');"><i class="bi bi-file-earmark-excel me-1"></i> Export Excel</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="mc-card h-100">
            <h5 class="mb-3"><i class="bi bi-bar-chart me-2 text-primary"></i>Department Distribution</h5>
            <canvas id="deptChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="mc-card h-100">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Department</th><th class="text-end">Students</th></tr></thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model.OrderByDescending(x => x.Value))
                            {
                                <tr>
                                    <td>@item.Label</td>
                                    <td class="text-end"><strong>@item.Value</strong></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted py-4">No data.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> All Reports</a>
</div>

@section Scripts {
<script>
(function () {
    var ctx = document.getElementById('deptChart');
    if (!ctx) return;
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(labels)),
            datasets: [{
                label: 'Students',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(values)),
                backgroundColor: 'rgba(11,107,203,0.75)',
                borderRadius: 8
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });
})();
</script>
}
