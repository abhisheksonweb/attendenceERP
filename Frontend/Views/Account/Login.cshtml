@model LoginViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Sign In";
    ViewData["AuthBodyClass"] = "auth-body";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="auth-canvas">
    <img class="auth-canvas__background" src="~/images/login-erp-background.png" asp-append-version="true" alt="" />

    <section class="auth-canvas__form">
        <div class="auth-split__inner">
            <div class="auth-login-logo">
                <img src="~/images/medcollege-logo.png" asp-append-version="true" alt="MedCollege" />
            </div>

            <h1 class="auth-split__title">Welcome back</h1>
            <p class="auth-split__subtitle">Sign in with your college email</p>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-1">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@medcollege.edu" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-1">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a asp-action="ForgotPassword" class="small">Forgot Password?</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <p class="auth-hint mt-2 mb-0">
                Admin: <code>admin@medcollege.edu</code> / <code>Admin@123</code><br />
                Student: your email · default password <code>Temp@123</code>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
