@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Access Denied";
}

<div class="auth-shell auth-shell--campus">
    <div class="auth-login-panel text-center">
        <div class="icon-xl mx-auto mb-3" style="background:#fde8e8;color:var(--mc-danger);">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 class="page-title mb-2">Access Denied</h2>
        <p class="page-subtitle mb-4">You don't have permission to view this page. Contact your administrator if you believe this is an error.</p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Go Back
            </a>
        </div>
    </div>
</div>
