@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_LayoutAuth";
    ViewData["AuthBodyClass"] = "auth-body";
}

<div class="auth-canvas">
    <div class="auth-canvas__form">
        <div class="auth-split__inner">
            <h1 class="auth-split__title">Change Password</h1>
            <p class="auth-split__subtitle">You must set a new password before continuing.</p>
            <form asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password <span class="text-danger">*</span></label>
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Update Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
