@model ForgotPasswordViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Forgot Password";
    ViewData["AuthBodyClass"] = "auth-body";
}

<div class="auth-split">
    <aside class="auth-split__visual" aria-hidden="true">
        <img src="~/images/login-campus.jpg" asp-append-version="true" alt="" />
    </aside>
    <section class="auth-split__form">
        <div class="auth-split__inner">
            <div class="auth-login-logo">
                <img src="~/images/medcollege-logo.png" asp-append-version="true" alt="MedCollege" />
            </div>
            <h1 class="auth-split__title">Reset password</h1>
            <p class="auth-split__subtitle">Enter your registered email</p>

            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@medcollege.edu" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-send me-1"></i> Send Reset Link
                </button>
                <a asp-action="Login" class="btn btn-link w-100 mt-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
