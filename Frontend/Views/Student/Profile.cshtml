@model StudentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    ViewData["Subtitle"] = "Update your information and request protected field changes";
    var protectedFields = ViewBag.ProtectedFields as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="mc-card text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Model.ProfilePhotoPath" alt="@Model.Name" class="rounded-circle border mb-3" width="120" height="120" style="object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width:120px;height:120px;font-size:3rem;">
                    <i class="bi bi-person"></i>
                </div>
            }
            <h4 class="mb-1">@Model.Name</h4>
            <p class="text-muted mb-2">@Model.StudentId</p>
            <div class="progress mb-2" style="height:8px;">
                <div class="progress-bar" style="width:@Model.ProfileCompletionPercent%"></div>
            </div>
            <small class="text-muted">@Model.ProfileCompletionPercent% complete</small>
            @if (Model.FaceRegistered)
            {
                <div class="badge text-bg-success mt-2"><i class="bi bi-shield-check me-1"></i> Face Registered</div>
            }
            else
            {
                <div class="badge text-bg-warning mt-2"><i class="bi bi-exclamation-circle me-1"></i> Face Not Registered</div>
            }
        </div>

        <div class="mc-card mt-3">
            <h6 class="mb-2">Protected Fields</h6>
            <p class="small text-muted mb-2">These require admin approval to change:</p>
            <ul class="list-unstyled small mb-0">
                @foreach (var f in protectedFields)
                {
                    <li class="mb-1"><i class="bi bi-lock me-1 text-muted"></i>@f</li>
                }
            </ul>
            <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-3" data-bs-toggle="modal" data-bs-target="#requestUpdateModal">
                <i class="bi bi-send me-1"></i> Request Update
            </button>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="mc-card">
            <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProfilePhotoPath" />

                <h5 class="mb-3"><i class="bi bi-pencil me-2 text-primary"></i>Editable Information</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Mobile" class="form-label">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Mobile" class="form-control" />
                        <span asp-validation-for="Mobile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EmergencyContact" class="form-label">Emergency Contact</label>
                        <input asp-for="EmergencyContact" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Pincode" class="form-label">Pincode</label>
                        <input asp-for="Pincode" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GuardianName" class="form-label">Guardian Name</label>
                        <input asp-for="GuardianName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GuardianPhone" class="form-label">Guardian Phone</label>
                        <input asp-for="GuardianPhone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GuardianEmail" class="form-label">Guardian Email</label>
                        <input asp-for="GuardianEmail" class="form-control" type="email" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="profilePhoto">Profile Photo</label>
                        <input type="file" name="profilePhoto" id="profilePhoto" class="form-control" accept="image/*" />
                        <div class="form-text">Your profile picture only — face for attendance is registered by admin.</div>
                        <img id="photoPreview" class="rounded border mt-2 d-none" width="72" height="72" style="object-fit:cover;" alt="Preview" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-save me-1"></i> Save Profile</button>
            </form>

            <hr class="my-4" />

            <h5 class="mb-3"><i class="bi bi-lock me-2 text-primary"></i>Read-Only Information</h5>
            <div class="row g-3">
                <div class="col-md-6"><span class="text-muted small">Enrollment Number</span><div>@Model.EnrollmentNumber</div></div>
                <div class="col-md-6"><span class="text-muted small">Email</span><div>@Model.Email</div></div>
                <div class="col-md-6"><span class="text-muted small">Course</span><div>@Model.Course</div></div>
                <div class="col-md-6"><span class="text-muted small">Department</span><div>@Model.Department</div></div>
                <div class="col-md-6"><span class="text-muted small">Semester</span><div>@Model.Semester</div></div>
                <div class="col-md-6"><span class="text-muted small">Date of Birth</span><div>@Model.DateOfBirth.ToString("dd MMM yyyy")</div></div>
                <div class="col-md-6"><span class="text-muted small">Gender</span><div>@Model.Gender</div></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="requestUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RequestUpdate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Request Field Update</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Field to Update <span class="text-danger">*</span></label>
                        <select name="FieldName" class="form-select" required>
                            <option value="">Select field...</option>
                            @foreach (var f in protectedFields)
                            {
                                <option value="@f">@f</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Value <span class="text-danger">*</span></label>
                        <input type="text" name="NewValue" class="form-control" required />
                    </div>
                    <p class="small text-muted mb-0">Your request will be reviewed by an administrator.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i> Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
(function () {
    const photo = document.getElementById('profilePhoto');
    const preview = document.getElementById('photoPreview');
    if (!photo || !preview) return;
    photo.addEventListener('change', function () {
        const file = this.files && this.files[0];
        if (!file) return;
        preview.src = URL.createObjectURL(file);
        preview.classList.remove('d-none');
    });
})();
</script>
}
