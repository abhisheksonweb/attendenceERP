@model ComingSoonViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="coming-soon">
    <div class="mc-card" style="max-width:520px;">
        <div class="icon-xl">
            <i class="bi @Model.Icon"></i>
        </div>
        <h2 class="page-title mb-2">@Model.Title</h2>
        <p class="page-subtitle mb-3">@Model.Description</p>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            <i class="bi bi-lightning-charge me-1"></i>Coming Soon — FastAPI Integration
        </span>
    </div>
</div>
