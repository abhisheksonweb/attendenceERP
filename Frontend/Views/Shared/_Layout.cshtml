@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var role = User.GetRole();

    string NavClass(string ctrl, string? act = null) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) &&
        (act is null || string.Equals(action, act, StringComparison.OrdinalIgnoreCase))
            ? "nav-link active"
            : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Medical College ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside id="appSidebar" class="sidebar">
        <div class="brand">
            <div class="brand-mark"><i class="bi bi-heart-pulse"></i></div>
            <div>
                <div class="fw-bold">MedCollege</div>
                <small class="opacity-75">Campus ERP</small>
            </div>
        </div>

        @if (User.IsInRole(nameof(UserRole.Admin)) || string.Equals(role, nameof(UserRole.Admin), StringComparison.OrdinalIgnoreCase))
        {
            <div class="nav-section">Administration</div>
            <nav class="nav flex-column sidebar-nav">
                <a class="@NavClass("Admin", "Index")" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-journal-bookmark"></i> Classes
                </a>
                <a class="@NavClass("Admin", "CreateClass")" asp-controller="Admin" asp-action="CreateClass">
                    <i class="bi bi-plus-square"></i> Create Class
                </a>
                <a class="@NavClass("Admin", "Students")" asp-controller="Admin" asp-action="Students">
                    <i class="bi bi-people"></i> All Students
                </a>
                <a class="@NavClass("Attendance")" asp-controller="Attendance" asp-action="Index">
                    <i class="bi bi-calendar-check"></i> Attendance
                </a>
                <a class="@NavClass("Admin", "Requests")" asp-controller="Admin" asp-action="Requests">
                    <i class="bi bi-inbox"></i> Requests
                </a>
                <a class="@NavClass("Admin", "ParentAlerts")" asp-controller="Admin" asp-action="ParentAlerts">
                    <i class="bi bi-phone"></i> Parent Alerts
                </a>
                <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-bar-chart-line"></i> Reports
                </a>
                <a class="@NavClass("Admin", "Notifications")" asp-controller="Admin" asp-action="Notifications">
                    <i class="bi bi-bell"></i> Notifications
                </a>
            </nav>
        }

        @if (User.IsInRole(nameof(UserRole.Student)) || string.Equals(role, nameof(UserRole.Student), StringComparison.OrdinalIgnoreCase))
        {
            <div class="nav-section">Student Portal</div>
            <nav class="nav flex-column sidebar-nav">
                <a class="@NavClass("Student", "Index")" asp-controller="Student" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="@NavClass("Student", "Profile")" asp-controller="Student" asp-action="Profile">
                    <i class="bi bi-person-circle"></i> Profile
                </a>
                <a class="@NavClass("Student", "AttendanceHistory")" asp-controller="Student" asp-action="AttendanceHistory">
                    <i class="bi bi-clock-history"></i> Attendance History
                </a>
                <a class="@NavClass("Student", "ActivityHistory")" asp-controller="Student" asp-action="ActivityHistory">
                    <i class="bi bi-journal-text"></i> Activity History
                </a>
                <a class="@NavClass("Student", "Notifications")" asp-controller="Student" asp-action="Notifications">
                    <i class="bi bi-bell"></i> Notifications
                </a>
                <a class="@NavClass("Student", "FaceEnrollment")" asp-controller="Student" asp-action="FaceEnrollment">
                    <i class="bi bi-person-bounding-box"></i> Face Enrollment
                </a>
            </nav>
        }

    </aside>

    <div class="main-wrap">
        <header class="topbar">
            <div class="d-flex align-items-center gap-2">
                <div>
                    <div class="page-title mb-0">@(ViewData["Title"] ?? "Dashboard")</div>
                    @if (ViewData["Subtitle"] is string subtitle)
                    {
                        <div class="page-subtitle">@subtitle</div>
                    }
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-light d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;">
                            <i class="bi bi-person-fill"></i>
                        </span>
                        <span class="d-none d-md-inline">
                            <span class="d-block fw-semibold small">@await Component.InvokeAsync("CurrentUserName")</span>
                            <span class="text-muted" style="font-size:.75rem;">@role</span>
                        </span>
                        <i class="bi bi-chevron-down small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li class="dropdown-header">@await Component.InvokeAsync("CurrentUserName")</li>
                        <li><hr class="dropdown-divider" /></li>
                        @if (User.IsInRole(nameof(UserRole.Student)))
                        {
                            <li><a class="dropdown-item" asp-controller="Student" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        }
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>

@await Html.PartialAsync("_Alerts")
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
