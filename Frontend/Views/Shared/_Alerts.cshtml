@{
    // Read once and clear so flash messages never render twice in the same page.
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    TempData.Remove("Success");
    TempData.Remove("Error");
}
<div id="mcToastContainer" class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite" aria-atomic="true">
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="toast mc-toast mc-toast-success align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="5000">
        <div class="d-flex w-100">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i>@success
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="toast mc-toast mc-toast-danger align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="7000">
        <div class="d-flex w-100">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
}
</div>
